% Student-Teacher-Subject Code Database

student_teacher('Arun', 'Kumar', 'CS101').
student_teacher('Bala', 'Ravi', 'CS102').
student_teacher('Charan', 'Suresh', 'CS103').
student_teacher('David', 'Raj', 'CS104').

% Display all records
display :-
    student_teacher(Student, Teacher, SubCode),
    write('Student: '), write(Student),
    write(', Teacher: '), write(Teacher),
    write(', Subject Code: '), write(SubCode),
    nl,
    fail.

display.
